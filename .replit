modules = ["python-base-3.13"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lean-build"

[[workflows.workflow]]
name = "lean-build"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && export PATH=\"$HOME/.elan/bin:$PATH\" && lake exe cache get 2>&1 && lake build Siegel.SiegelZeroFreeElementary 2>&1"
